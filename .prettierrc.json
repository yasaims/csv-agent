{
  "overrides": [
    {
      "files": ["*.html", "*.js", "*.css"],
      "options": {
        "printWidth": 120,
        "tabWidth": 2,
        "useTabs": false,
        "semi": true,
        "singleQuote": false,
        "trailingComma": "all",
        "arrowParens": "always",
        "bracketSameLine": false,
        "htmlWhitespaceSensitivity": "css",
        "endOfLine": "lf"
      }
    }
  ]
}
